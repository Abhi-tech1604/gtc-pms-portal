# GTC Oilfield PMS Portal — production environment template
# Copy this file to `.env` next to it (server\.env) and fill in real values.
# Never commit the real .env file. Nothing in this app reads secrets from
# source code — everything below is the complete set of runtime settings.
#
# This app's database is an embedded SQLite file (better-sqlite3), not a
# database server — there is no host/port/username/password to configure for
# it. DB_FILE simply points at the existing, already-populated database file
# copied over from the current environment. Do not point this at a new/empty
# path — that would create a brand-new empty database instead of using the
# existing one.

# --- Network ---
PORT=4000
HOST=0.0.0.0

# --- Data locations (put these on a data volume, not the OS/system drive) ---
DATA_DIR=D:\GTC-PMS\data
DB_FILE=D:\GTC-PMS\data\pms.db
UPLOAD_DIR=D:\GTC-PMS\data\uploads
BACKUP_DIR=D:\GTC-PMS\backups

# --- Application ---
TIMEZONE=Asia/Kolkata
SESSION_HOURS=12
MAX_UPLOAD_MB=25

# JWT_SECRET signs every login session. Generate a long random value unique
# to this installation — e.g. in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
# Changing this value later signs every user out at once. The app refuses to
# start in production (NODE_ENV=production) while this is left at the
# placeholder value.
JWT_SECRET=change-me-in-production

# Comma-separated list of origins allowed to call the API cross-origin.
# In this deployment the built frontend is served BY this same backend on the
# same origin (see client/dist), so this normally stays empty/unset — it only
# matters if some other origin (a second server, a mobile app, etc.) calls
# this API directly.
CORS_ORIGINS=

# --- Node runtime mode ---
# Setting this is what activates the JWT_SECRET placeholder guard above.
NODE_ENV=production

# --- First-boot administrator account ---
# Only read the very first time the database has zero Admin accounts — this
# app already has real users/rigs/equipment/etc. data, so on an existing
# database these are ignored entirely and nothing is created or changed.
# Set them anyway so a fresh disaster-recovery restore-to-empty-db is safe.
ADMIN_USERNAME=pmsadmin
ADMIN_PASSWORD=change-me-strong-password
