# GTC PMS Portal — server environment
# Copy to `.env` and fill in real values. Never commit the real .env.

# --- Application ---
PORT=3004
HOST=0.0.0.0
TIMEZONE=Asia/Kolkata
SESSION_HOURS=12
MAX_UPLOAD_MB=25

# JWT_SECRET signs every login session. Generate a long random value unique to
# this installation — e.g. in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
# The app refuses to start with NODE_ENV=production while this is the placeholder.
JWT_SECRET=change-me-in-production

# Origins allowed to call the API cross-origin. The built frontend is served by
# this same process on the same origin, so this normally stays empty.
CORS_ORIGINS=

NODE_ENV=production

# --- PostgreSQL ---
# Either provide one DATABASE_URL...
DATABASE_URL=postgresql://gtc_admin:YOUR_PASSWORD@localhost:5432/gtc_pms

# ...or the discrete variables below (used only when DATABASE_URL is unset).
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=gtc_pms
# PGUSER=gtc_admin
# PGPASSWORD=YOUR_PASSWORD

DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20

# --- File storage (uploads/backups are files, not database rows) ---
DATA_DIR=D:\GTC-PMS\data
UPLOAD_DIR=D:\GTC-PMS\data\uploads
BACKUP_DIR=D:\GTC-PMS\backups

# Path to the legacy SQLite database. Read ONLY by
# `npm run migrate:sqlite-to-postgres`; the running application no longer uses
# it once the PostgreSQL cutover is complete. Never deleted by any script.
DB_FILE=D:\GTC-PMS\data\pms.db

# --- First-boot administrator (ignored once an Admin account exists) ---
ADMIN_USERNAME=pmsadmin
ADMIN_PASSWORD=change-me-strong-password
