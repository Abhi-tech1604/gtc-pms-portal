{
  "name": "pms-portal-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:postgres": "tsx src/db/migrate.postgres.ts",
    "migrate:sqlite-to-postgres": "tsx src/scripts/migrate-sqlite-to-postgres.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "tsx --env-file=.env.test --test --test-concurrency=1 tests/*.test.ts",
    "backup": "tsx src/scripts/backup.ts",
    "reset": "tsx src/scripts/reset.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.0.1",
    "pdfkit": "^0.20.1",
    "pg": "^8.23.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
